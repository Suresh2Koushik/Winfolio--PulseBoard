# Used by `npm run test:e2e` only. Points the app at the local Firebase emulators;
# these are placeholder values, not real credentials.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pulseboard.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-pulseboard
VITE_FIREBASE_STORAGE_BUCKET=demo-pulseboard.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
VITE_FEATURE_TEAMS=true
