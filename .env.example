# Firebase web app config (Firebase console → Project settings → Your apps).
# These values identify the project; access is controlled by firestore.rules/storage.rules.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Set to 'true' to use local emulators in `npm run dev` (see README)
VITE_USE_EMULATORS=false

# Optional: reCAPTCHA Enterprise (Google Cloud Fraud Defense) key ID for Firebase App Check (see README > App Check).
# Leave empty to run without App Check.
VITE_APPCHECK_SITE_KEY=
