rules_version = '2';

// PulseBoard Storage rules: activity attachments are private to their owner.
service firebase.storage {
  match /b/{bucket}/o {

    match /activities/{userId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('text/(plain|csv)')
            || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')
            || request.resource.contentType.matches('application/(msword|vnd\\.ms-excel|vnd\\.ms-powerpoint)'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
